# Doxyfile 1.9.8

# This file describes the settings to be used by the documentation system
# doxygen (www.doxygen.org) for a project.
#
# All text after a double hash (##) is considered a comment and is placed in
# front of the TAG it is preceding.
#
# The format is:
#   TAG = value [value, ...]
# For lists, items can also be appended using:
#   TAG += value [value, ...]
# Values that contain spaces should be placed between quotes (" ").

# Project related configuration options
#---------------------------------------------------------------------------

# This tag specifies the encoding used for all characters in the config file
# that follow. The default is UTF-8 which is also the encoding used for all
# text before the first occurrence of this tag.
DOXYFILE_ENCODING      = UTF-8

# The PROJECT_NAME tag is a single word (or a sequence of words surrounded by
# double-quotes, unless you are using Doxywizard) that should identify the
# project for which the documentation is generated. This name is used in the
# title of most generated pages and in a few other places.
PROJECT_NAME           = "Segfault Game Engine"

# The PROJECT_NUMBER tag can be used to enter a project number or version
# identifier. When the VERSION option is set to YES in the configuration
# file then this will be used as the version of the project. See also
# the VERSION tag.
PROJECT_NUMBER         = 0.1.0

# Using the PROJECT_BRIEF tag one can provide an optional one line description
# for a project that appears at the top of each page and should give viewer a
# quick idea about the purpose of the project. Keep the description short.
PROJECT_BRIEF          = "Vulkan-based game engine written in C++17"

# With the PROJECT_LOGO tag one can specify a logo or icon that is included in
# the documentation. The maximum height of the logo should not exceed 55 pixels
# and the maximum width should not exceed 200 pixels. Doxygen will copy the logo
# from the file and place it in the HTML output directory.
PROJECT_LOGO           = 

# The OUTPUT_DIRECTORY tag is used to specify the (relative or absolute) path
# into which the generated documentation will be written. If a relative path
# is entered, it will be relative to the location where doxygen was started. If
# left blank the current directory will be used.
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/html

# If the CREATE_SUBDIRS tag is set to YES, then doxygen will create 4096 sub-
# directories (in 2 levels) under the output directory of each output format.
# This can be used to split up a large documentation set in smaller parts.
CREATE_SUBDIRS         = NO

# The OUTPUT_LANGUAGE tag is used to specify the language in which all
# documentation generated by doxygen is written. Doxygen will use this
# information to generate all constant output in the proper language.
OUTPUT_LANGUAGE       = English

# If the BRIEF_MEMBER_DESC tag is set to YES, then doxygen will include brief
# member descriptions after the members that are listed in the file and class
# documentation (similar to JavaDoc). Set to NO to disable this.
BRIEF_MEMBER_DESC      = YES

# If the REPEAT_BRIEF tag is set to YES, then doxygen will repeat the brief
# description (defined by the \brief command) before the detailed member
# description. If set to NO, the brief description will only appear in the
# member list and not in the detailed description of the member.
REPEAT_BRIEF          = YES

# This tag implements a quasi-preprocessor that will replace each occurrence
# of the target word with the replacement text. For instance, if you want to
# replace "My Company Inc." with "ABC" then specify
# ALIASES += "My Company Inc.==ABC"
ALIASES               = 

# The OPTIMIZE_OUTPUT_JAVASCRIPT tag can be used to indicate that the
# HTML output should be further optimized using JavaScript.
# Doxygen will then remove redundant qualifiers and include statements
# from the generated HTML output and instead put them in a separate JavaScript
# file. This can reduce the size of the HTML files significantly.
# The default value is: YES
OPTIMIZE_OUTPUT_JAVA  = YES

# If the OPTIMIZE_OUTPUT_SLIM tag is set to YES the JavaScript will be further
# optimized using a built-in JavaScript slim optimization algorithm.
# The default value is: NO
OPTIMIZE_OUTPUT_SLIM = NO

# Set the OPTIMIZE_FOR_FORTRAN tag to YES if your project consists of Fortran
# sources. Doxygen will then generate output tailored for Fortran code.
OPTIMIZE_FOR_FORTRAN = NO

# Set the OPTIMIZE_OUTPUT_JAVA tag to YES if your project consists of Java or
# Python sources. Doxygen will then generate output tailored for Java/Python
# code.
OPTIMIZE_OUTPUT_JAVA  = NO

# Set the OPTIMIZE_FOR_JAVASCRIPT tag to YES if your project consists of
# JavaScript sources. Doxygen will then generate output tailored for
# JavaScript code.
OPTIMIZE_FOR_JAVASCRIPT = NO

# Set the EXTRACT_ALL tag to YES to force the extraction of all entities from
# the source files. This is helpful for C++ projects where the class members
# are not explicitly documented.
EXTRACT_ALL           = YES

# If the EXTRACT_PRIVATE tag is set to YES, then all private members of
# classes will be included in the documentation.
EXTRACT_PRIVATE       = YES

# If the EXTRACT_STATIC tag is set to YES, then static members will be included
# in the documentation.
EXTRACT_STATIC        = YES

# If the EXTRACT_LOCAL_CLASSES tag is set to YES, then classes (and structs)
# defined locally in source files will be included in the documentation.
EXTRACT_LOCAL_CLASSES  = YES

# This flag is only useful for Objective-C code. If set to YES, then local
# methods, which are defined in the implementation section but not in the
# interface are included in the documentation. If set to NO (the default),
# these methods are not included.
EXTRACT_LOCAL_METHODS  = YES

# If the EXTRACT_ANON_NSPACES tag is set to YES, then doxygen will also
# extract anonymous namespaces from the code.
EXTRACT_ANON_NSPACES  = YES

# If this flag is set to YES, the contents of anonymous namespaces will be
# extracted and appear in the documentation as if their contents had been put
# in the global namespace.
EXTRACT_ANON_NSPACE_MEMBERS = NO

# If the HIDE_UNDOC_MEMBERS tag is set to YES, then doxygen will hide all
# undocumented members of documented classes and files. If set to NO, these
# members will be included in the documentation and marked as "undocumented".
HIDE_UNDOC_MEMBERS    = NO

# If the HIDE_UNDOC_CLASSES tag is set to YES, then doxygen will hide all
# undocumented classes that are normally visible in the class hierarchy. If set
# to NO, these classes will be included in the class hierarchy and marked as
# "undocumented".
HIDE_UNDOC_CLASSES    = NO

# If the HIDE_FRIEND_COMPOUNDS tag is set to YES, then doxygen will hide all
# friend declarations. If set to NO, these declarations will be included in
# the documentation.
HIDE_FRIEND_COMPOUNDS = NO

# If the HIDE_IN_BODY_DOCS tag is set to YES, then doxygen will hide all
# documentation for functions and class members that appears inside the body of
# a function or class definition.
HIDE_IN_BODY_DOCS     = NO

# If the INTERNAL_DOCS tag is set to YES, then doxygen will also process the
# \internal command and include the documentation in the output. If set to NO,
# these commands are left in the source code but will be omitted from the output.
INTERNAL_DOCS         = NO

# If the CASE_SENSE_NAMES tag is set to NO, then doxygen will only generate
# file names in lower-case letters. If set to YES, upper-case letters are
# allowed. This is useful if you have classes or files whose names only differ
# in case and if your file system supports case-sensitive file names. Windows
# and Mac users are advised to set this option to NO.
CASE_SENSE_NAMES      = NO

# If the HIDE_SCOPE_NAMES tag is set to NO, then doxygen will show members with
# their full class and namespace scopes in the documentation. If set to YES, the
# scope will be hidden.
HIDE_SCOPE_NAMES     = NO

# If the SHOW_INCLUDE_FILES tag is set to YES, then doxygen will list all the
# include files that are included by a file in the documentation of that file.
SHOW_INCLUDE_FILES    = YES

# If the FORCE_LOCAL_INCLUDES tag is set to YES, then doxygen will list include
# files with the INCLUDE_AS_MEMBER_ST tag also when they are included only in
# source files.
FORCE_LOCAL_INCLUDES  = NO

# If the INLINE_INFO tag is set to YES, then a tag [inline] is inserted in the
# documentation for inline members.
INLINE_INFO           = YES

# If the SORT_MEMBER_DOCS tag is set to YES, then doxygen will sort the
# (detailed) documentation of file and class members alphabetically by member
# name. If set to NO, the members will appear in declaration order.
SORT_MEMBER_DOCS     = NO

# If the SORT_BRIEF_DOCS tag is set to YES, then doxygen will sort the brief
# descriptions of file, namespace and class members alphabetically by member
# name. If set to NO, the members will appear in declaration order.
SORT_BRIEF_DOCS      = NO

# If the SORT_MEMBERS_CTORS_1ST tag is set to YES, then doxygen will sort the
# (detailed) documentation of class members so that constructors and destructors
# are listed first. If set to NO, the constructors and destructors will be
# listed in the same order as the other class members.
SORT_MEMBERS_CTORS_1ST = NO

# If the SORT_GROUP_NAMES tag is set to YES, then doxygen will sort the hierarchy
# of group names in the documentation of a file. If set to NO, the group names
# will appear in their defined order.
SORT_GROUP_NAMES     = NO

# If the SORT_BY_SCOPE_NAME tag is set to YES, then doxygen will sort groups of
# members in the documentation by the scope in which they are declared.
SORT_BY_SCOPE_NAME   = NO

# The GENERATE_TODOLIST tag can be used to enable (YES) or disable (NO) the todo
# list. Doxygen will then extract the todo items from the source code and
# include them in the documentation.
GENERATE_TODOLIST     = YES

# The GENERATE_TESTLIST tag can be used to enable (YES) or disable (NO) the test
# list. Doxygen will then extract the test items from the source code and
# include them in the documentation.
GENERATE_TESTLIST     = YES

# The GENERATE_BUGLIST tag can be used to enable (YES) or disable (NO) the bug
# list. Doxygen will then extract the bug items from the source code and include
# them in the documentation.
GENERATE_BUGLIST     = YES

# The GENERATE_DEPRECATEDLIST tag can be used to enable (YES) or disable (NO) the
# deprecated list. Doxygen will then extract the deprecated items from the
# source code and include them in the documentation.
GENERATE_DEPRECATEDLIST = YES

# If the ENABLED_SECTIONS tag is set to YES, then doxygen will enable the use of
# the \enable command. This can be used to enable or disable the generation of
# certain parts of the documentation.
ENABLED_SECTIONS      = YES

# The MAX_INITIALIZER_LINES tag determines the maximum number of lines that the
# initial value of a variable or macro can have for it to appear in the
# documentation. If the initial value consists of more than MAX_INITIALIZER_LINES
# lines then it will be omitted from the output and replaced with the \<...\>
# string.
MAX_INITIALIZER_LINES = 30

# Set the SHOW_USED_FILES tag to YES to list all the files that are explicitly
# or implicitly used by the documented files.
SHOW_USED_FILES      = YES

# If the SHOW_FILES tag is set to YES, then doxygen will list all the files that
# are included in the documentation in the index page.
SHOW_FILES           = YES

# Set the SHOW_NAMESPACES tag to YES to list all the namespaces in the
# documentation of a file or class. If set to NO only the namespaces that are
# used in the documented file/class will be shown.
SHOW_NAMESPACES      = YES

# The FILE_VERSION_FILTER tag can be used to specify a program or script that
# doxygen should invoke to get the current version for each file (typically from
# the version control system). Doxygen will invoke the program by executing
# (via popen()) the command <command> <input-file>, where <command> is the value
# of the FILE_VERSION_FILTER tag, and <input-file> is the name of an input file
# passed to doxygen. Whatever the program outputs to standard output is used as
# the file version. For an example see the documentation.
FILE_VERSION_FILTER   = 

# The LAYOUT_FILE tag can be used to specify a layout file which will be parsed
# by doxygen. The layout file controls the global structure of the generated
# output files in an output format in a similar way as a web site. The layout
# file has a different format for each supported output file format.
