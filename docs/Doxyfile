#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

# The INPUT tag is used to specify the files and/or directories that should be
# parsed by doxygen. You can specify the INPUT tags in a number of ways:
#   - INPUT = file1 file2 file3 ...
#   - INPUT = dir1 dir2 dir3 ...
#   - INPUT = dir1 file1 dir2 file2 ...
#   - INPUT = glob-pattern1 glob-pattern2 ...
#
# Note that relative paths are relative to the directory from which doxygen
# is run.
INPUT                  = "@CMAKE_SOURCE_DIR@/src/runtime" "@CMAKE_SOURCE_DIR@/src/contrib/cppcore/include" "@CMAKE_SOURCE_DIR@/docs/Architecture.md"

# This tag can be used to specify the character encoding of the source files
# that doxygen parses. Internally doxygen uses the UTF-8 encoding. Doxygen uses
# libiconv (or the iconv built into libstdc++) for the transcoding. See the
# libiconv documentation (see: http://www.gnu.org/software/libiconv) for the
# list of possible encodings.
INPUT_ENCODING        = UTF-8

# If the value of the INPUT tag contains directories, you can use the
# FILE_PATTERNS tag to specify one or more wildcards to match certain files
# inside those directories.
FILE_PATTERNS        = *.h *.cpp *.c *.md

# The RECURSIVE tag can be used to specify whether or not subdirectories should
# be searched for input files as well.
RECURSIVE             = YES

# The EXCLUDE tag can be used to specify files and/or directories that should be
# excluded from the INPUT tag. Wildcards can be used to specify the files and/or
# directories to exclude. By default all files and directories in the path
# specified by INPUT are included in the documentation.
EXCLUDE               = src/contrib/cppcore/contrib src/contrib/cppcore/test

# The EXCLUDE_SYMLINKS tag can be used to select whether to exclude symbolic
# links. If set to YES, symbolic links to files or directories will be
# excluded. If set to NO, they will be included.
EXCLUDE_SYMLINKS     = NO

# If the value of the INPUT tag contains directories, you can use the
# EXCLUDE_PATTERNS tag to specify one or more wildcards to exclude certain
# files from those directories. Note that the wildcards must match the file
# names, not the path.
EXCLUDE_PATTERNS     = 

# The EXCLUDE_SYMBOLS tag can be used to specify one or more symbol names
# (namespaces, classes, functions, etc.) that should be excluded from the
# output. The symbol name can be a fully qualified name, a word, or if the
# wildcard * is used, it can match any sequence of characters.
EXCLUDE_SYMBOLS       = 

# The EXAMPLE_PATH tag can be used to specify one or more files or directories
# that contain example code fragments that are included (see the \include
# command).
EXAMPLE_PATH         = src/examples

# If the value of the EXAMPLE_PATH tag contains directories, you can use the
# EXAMPLE_PATTERNS tag to specify one or more wildcards to match certain files
# inside those directories.
EXAMPLE_PATTERNS    = *.cpp *.h

# If the EXAMPLE_RECURSIVE tag is set to YES, then doxygen will also look into
# subdirectories for files to include in the examples.
EXAMPLE_RECURSIVE    = YES

# The IMAGE_PATH tag can be used to specify one or more files or directories
# that contain images that are to be included in the documentation.
IMAGE_PATH            = docs/

# The INPUT_FILTER tag can be used to specify a program to preprocess the input
# for files. Doxygen will execute the program by executing (via popen()) the
# command <filter> <input-file>, where <filter> is the value of the INPUT_FILTER
# tag, and <input-file> is the name of an input file. Whatever the filter
# outputs to standard output is used as input for doxygen.
INPUT_FILTER          = 

# The FILTER_PATTERNS tag can be used to specify filters on a per file pattern
# basis. Doxygen will use the filter that matches the file pattern to
# preprocess the file.
FILTER_PATTERNS      = 

# The FILTER_SOURCE_FILES tag can be used to specify whether to apply the input
# filter to source files as well. If not specified, the default is YES.
FILTER_SOURCE_FILES  = YES

# The FILTER_SOURCE_PATTERNS tag can be used to specify source file patterns for
# which the input filter should be applied. If not specified, the default is
# all source files.
FILTER_SOURCE_PATTERNS = 

#---------------------------------------------------------------------------
# Configuration options related to source browsing
#---------------------------------------------------------------------------

# If the SOURCE_BROWSER tag is set to YES, then a list of source files will be
