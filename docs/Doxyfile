# If the ENABLE_PREPROCESSING tag is set to YES, then doxygen will evaluate
# all C-preprocessor directives found in the sources and include files.
ENABLE_PREPROCESSING  = YES

# If the MACRO_EXPANSION tag is set to YES, then doxygen will expand all
# macro invocations in the source code. If set to NO, then only conditional
# compilation will be performed. Macro expansion can be done in a controlled
# way by setting EXPAND_ONLY_PREDEF to YES.
MACRO_EXPANSION       = YES

# If the EXPAND_ONLY_PREDEF tag is set to YES, then doxygen will only expand
# macros that have been defined in the PREDEFINED tag. If set to NO, then doxygen
# will expand all macros.
EXPAND_ONLY_PREDEF    = NO

# The PREDEFINED tag can be used to specify one or more macro names that should be
# defined before the preprocessor starts. The macro definitions are given as
# key=value pairs. If the value is empty, the macro is defined without a value.
# Multiple macro definitions can be specified as a space-separated list.
PREDEFINED             = SEGFAULT_EXPORT= SEGFAULT_WINDOWS=1

# If the EXPAND_AS_DEFINED tag is set to a list of macro names, then doxygen will
# expand the macro as if it were defined. For each macro name in the list, the
# macro will be expanded as if it were a #define with no arguments. If the macro
# name is followed by a : then the macro will be expanded as if it were a
# #define with the specified number of arguments.
EXPAND_AS_DEFINED     = 

# The SKIP_FUNCTION_MACROS tag can be used to specify that preprocessor macros
# that expand to a function definition should be skipped. If set to YES, such
# macros will be skipped. If set to NO, they will be included.
SKIP_FUNCTION_MACROS  = YES

#---------------------------------------------------------------------------
# Configuration options related to the C and C++ languages
#---------------------------------------------------------------------------

# If the EXTRACT_ALL tag is set to YES, then doxygen will also extract the
# following items from the source code:
#   - Static members of classes
#   - Static global functions
#   - Non-public class members (including inherited ones)
#   - Enumeration values
#   - Preprocessor definitions
EXTRACT_ALL           = YES

# If the EXTRACT_PRIVATE tag is set to YES, then all private members of
# classes will be included in the documentation.
EXTRACT_PRIVATE       = YES

# If the EXTRACT_STATIC tag is set to YES, then doxygen will also extract
# static members of classes and static global functions.
EXTRACT_STATIC        = YES

# If the EXTRACT_LOCAL_CLASSES tag is set to YES, then doxygen will also
# extract classes (and structs) defined locally in source files.
EXTRACT_LOCAL_CLASSES  = YES

# If the HIDE_UNDOC_MEMBERS tag is set to YES, then doxygen will hide all
# undocumented members inside documented classes or files.
HIDE_UNDOC_MEMBERS    = NO

# If the HIDE_UNDOC_CLASSES tag is set to YES, then doxygen will hide all
# undocumented classes that are normally visible in the class hierarchy.
HIDE_UNDOC_CLASSES    = NO

# If the HIDE_FRIEND_COMPOUNDS tag is set to YES, then doxygen will hide all
# friend declarations.
HIDE_FRIEND_COMPOUNDS = NO

# If the HIDE_IN_BODY_DOCS tag is set to YES, then doxygen will hide all
# documentation for functions and class members that appears inside the body of
# a function or class definition.
HIDE_IN_BODY_DOCS     = NO

# If the INTERNAL_DOCS tag is set to YES, then doxygen will also process the
# \internal command and include the documentation in the output.
INTERNAL_DOCS         = NO

# If the CASE_SENSE_NAMES tag is set to NO, then doxygen will only generate
# file names in lower-case letters. If set to YES, upper-case letters are
# allowed. This is useful if you have classes or files whose names only differ
# in case and if your file system supports case-sensitive file names.
CASE_SENSE_NAMES      = NO

# If the HIDE_SCOPE_NAMES tag is set to NO, then doxygen will show members with
# their full class and namespace scopes in the documentation.
HIDE_SCOPE_NAMES     = NO

# If the SHOW_INCLUDE_FILES tag is set to YES, then doxygen will list all the
# include files that are included by a file in the documentation of that file.
SHOW_INCLUDE_FILES    = YES

# If the FORCE_LOCAL_INCLUDES tag is set to YES, then doxygen will list include
# files with the INCLUDE_AS_MEMBER_ST tag also when they are included only in
# source files.
FORCE_LOCAL_INCLUDES  = NO

# If the INLINE_INFO tag is set to YES, then a tag [inline] is inserted in the
# documentation for inline members.
INLINE_INFO           = YES

# If the SORT_MEMBER_DOCS tag is set to YES, then doxygen will sort the
# (detailed) documentation of file and class members alphabetically by member
# name.
SORT_MEMBER_DOCS     = NO

# If the SORT_BRIEF_DOCS tag is set to YES, then doxygen will sort the brief
# descriptions of file, namespace and class members alphabetically by member
# name.
SORT_BRIEF_DOCS      = NO

# If the SORT_MEMBERS_CTORS_1ST tag is set to YES, then doxygen will sort the
# (detailed) documentation of class members so that constructors and destructors
# are listed first.
SORT_MEMBERS_CTORS_1ST = NO

# If the SORT_GROUP_NAMES tag is set to YES, then doxygen will sort the hierarchy
# of group names in the documentation of a file.
SORT_GROUP_NAMES     = NO

# If the SORT_BY_SCOPE_NAME tag is set to YES, then doxygen will sort groups of
# members in the documentation by the scope in which they are declared.
SORT_BY_SCOPE_NAME   = NO

# If the STRICT_PROTECTED_MATCHING tag is set to YES, then doxygen will
# consider a class member to be protected if it is declared as such in the
# source code. Otherwise, it will consider a class member to be protected if it
# is declared in a protected section.
STRICT_PROTECTED_MATCHING = NO

#---------------------------------------------------------------------------
# Configuration options related to the dot tool
#---------------------------------------------------------------------------

# Set the DOT image format for graph generation. Doxygen can generate graphs
# in several formats, including PNG, JPEG, GIF, and SVG. The default is PNG.
# Note: To use dot graphs, you must have Graphviz (dot) installed.
HAVE_DOT               = NO

# If the DOT_NUM_THREADS tag is set to a number greater than 0, then doxygen will
# use that many threads to generate the graphs. The default is 0, which means
# doxygen will use a single thread.
DOT_NUM_THREADS       = 0

# Set the DOT_FONTNAME tag to the preferred font for dot graphs. The default
# font is Helvetica.
DOT_FONTNAME          = Helvetica

# Set the DOT_FONTSIZE tag to the preferred font size for dot graphs. The
# default font size is 10.
DOT_FONTSIZE          = 10

# Set the DOT_FONTPATH tag to the directory containing the fonts for dot graphs.
# If left blank, doxygen will use the system fonts.
DOT_FONTPATH          = 

# Set the CLASS_GRAPH tag to YES to generate a collaboration graph for each class.
CLASS_GRAPH           = YES

# Set the COLLABORATION_GRAPH tag to YES to generate a collaboration graph for
# each class. This shows the inheritance and usage relations between classes.
COLLABORATION_GRAPH   = YES

# Set the GROUP_GRAPHS tag to YES to generate graphs for groups of classes.
GROUP_GRAPHS          = YES

# Set the UML_LOOK tag to YES to generate UML-style class diagrams.
UML_LOOK              = NO

# Set the UML_LIMIT_NUM_FIELDS tag to the maximum number of fields to show in
# UML diagrams. The default is 100.
UML_LIMIT_NUM_FIELDS = 100

# Set the TEMPLATE_RELATIONS tag to YES to include template relations in the
# class diagrams.
TEMPLATE_RELATIONS    = YES

# Set the INCLUDE_GRAPH tag to YES to generate a graph showing which files are
# directly or indirectly included by each file.
INCLUDE_GRAPH         = YES

# Set the INCLUDED_BY_GRAPH tag to YES to generate a graph showing which files
# include this file.
INCLUDED_BY_GRAPH     = YES

# Set the CALL_GRAPH tag to YES to generate a call graph for each function.
CALL_GRAPH            = NO

# Set the CALLER_GRAPH tag to YES to generate a caller graph for each function.
CALLER_GRAPH          = NO

# Set the GRAPHICAL_HIERARCHY tag to YES to generate a graphical hierarchy of
# classes.
GRAPHICAL_HIERARCHY   = YES

# Set the DIRECTORY_GRAPH tag to YES to generate a directory dependency graph.
DIRECTORY_GRAPH       = YES

#---------------------------------------------------------------------------
# Configuration options related to the search engine
#---------------------------------------------------------------------------

# If the SEARCHENGINE tag is set to YES, then doxygen will generate a search
# engine for the HTML output.
SEARCHENGINE          = YES
